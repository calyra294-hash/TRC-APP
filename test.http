### ----------------------------------------------------
### PASO 1: Obtener el ID Token simulando al Frontend
### ----------------------------------------------------
# @name loginFirebase
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}
Content-Type: application/json

{
  "email": "correo_de_tu_usuario@ejemplo.com",
  "password": "tu_contraseña",
  "returnSecureToken": true
}

### ----------------------------------------------------
### PASO 2: Probar el endpoint de tu Backend con el Token anterior
### ----------------------------------------------------
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "idToken": "{{loginFirebase.response.body.idToken}}"
}